---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
---

{/* Denne siden er kommentert ut, enn så lenge! */}

<BaseLayout>
    
    <h1 class="text-center mt-10 mb-15 text-3xl">Art</h1>
   <p class="mb-6 uppercase font-semibold text-sm text-center tracking-wide">
        Acrylics · Digital art · Graphite · Mixed media · Watercolour
    </p>

    <p class="text-center mt-10 text-sm md:text-lg max-w-3xl mx-auto">
        I have always been passionate about art, and it has been a significant part of my life. 
        My artistic journey has allowed me to express myself creatively and develop a unique perspective that I bring into my work as an IT student.
    </p>

    <p class="mt-10 text-center text-3xl">
        🌸
    </p>

    {/* Gallery Section */}
    <section class="mt-20 flex items-baseline flex-wrap gap-4 mb:20 justify-center">

        <img src="/images/maleri.png" class="w-80 h-80 object-cover shadow-2xl transition-transform duration-500 hover:scale-105 rounded-2xl" />
        <img src="/images/tegning2.png" class="w-70 h-95 object-cover shadow-2xl transition-transform duration-500 hover:scale-105 rounded-2xl" />

    </section>

</BaseLayout>