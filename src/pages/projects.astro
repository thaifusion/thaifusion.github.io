                    <span data-lang="no">Discgolf mobilapp</span>
                    </h5>

                    {/* Tech stack */}
                    <p class="mb-6 uppercase text-xs tracking-wide">
                    Kotlin · Android · Heroku · MongoDB · Google Maps API · ChatGPT API
                    </p>

