            <div class="mt-10 space-y-10">
      

                {/* Portfolio project BOP */}
                {/* image + link */}
                <div class="group max-w-2xl mx-auto rounded-2xl dark:bg-white/25 p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:scale-[1.01] hover:shadow-2xl hover:bg-purple-400/20">
                <a href="https://github.com/BOP-PortfoljeHK/PortfoljesideHK" target="_blank" class="block">
