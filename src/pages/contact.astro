---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    
    <div class="mx-auto max-w-screen-2xl">

        <section class="mt-24 px-6">
  <div class="mx-auto max-w-3xl rounded-3xl bg-white/30 dark:bg-white/10 p-8 shadow-2xl backdrop-blur-md text-center hover:scale-105 transition-all duration-300">

    <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-white/70 dark:bg-white/20 text-3xl shadow-lg">
      ✉️
    </div>

    <h1 class="text-4xl md:text-5xl font-serif mb-4">
      Contact Me
    </h1>

    <p class="mx-auto max-w-md text-lg opacity-80 mb-8">
      Want to collaborate, ask a question, or just say hi?
    </p>

    <a
      href="mailto:sara.orj@gmail.com"
      class="inline-block rounded-full bg-black px-6 py-3 text-white transition-all duration-300 hover:scale-105 hover:bg-purple-500 dark:bg-white dark:text-black dark:hover:bg-purple-400 shadow-lg"
    >
      Send me an email
    </a>

    <div class="mt-10 flex justify-center gap-6">
      <a
        href="https://linkedin.com/in/sara-m-%C3%B8-40a831407/"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-white/40 dark:bg-purple/20 p-4 text-gray-900 dark:text-white transition-all duration-300 hover:scale-110 hover:text-purple-500 dark:hover:text-purple-400 shadow-lg"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor"
                        viewBox="0 0 24 24" class="w-8 h-8">
                    <path d="M4.98 3.5C4.98 4.88 3.86 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.5 8h4V24h-4V8zm7.5 0h3.8v2.2h.05c.53-1 1.83-2.2 3.77-2.2 4.03 0 4.78 2.65 4.78 6.1V24h-4v-7.8c0-1.86-.03-4.25-2.6-4.25-2.6 0-3 2.03-3 4.12V24h-4V8z"/>
                    </svg>
      </a>

      <a
        href="https://github.com/thaifusion"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-white/40 dark:bg-purple/20 p-4 text-gray-900 dark:text-white transition-all duration-300 hover:scale-110 hover:text-purple-500 dark:hover:text-purple-400 shadow-lg"
      >
        <!-- GitHub SVG her -->
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor"
                        viewBox="0 0 24 24" class="w-8 h-8">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.1.82-.26.82-.58v-2.2c-3.34.72-4.04-1.6-4.04-1.6-.55-1.38-1.34-1.75-1.34-1.75-1.1-.76.08-.74.08-.74 1.22.08 1.86 1.25 1.86 1.25 1.08 1.85 2.83 1.32 3.52 1 .1-.8.42-1.32.76-1.62-2.66-.3-5.46-1.33-5.46-5.93 0-1.3.46-2.37 1.23-3.2-.12-.3-.53-1.52.12-3.18 0 0 1-.32 3.3 1.22a11.5 11.5 0 016 0C17 3.3 18 3.6 18 3.6c.65 1.66.24 2.88.12 3.18.77.83 1.23 1.9 1.23 3.2 0 4.61-2.8 5.62-5.47 5.92.43.37.82 1.1.82 2.22v3.3c0 .32.22.7.83.58C20.56 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
        </a>
  </div>
</section>

</BaseLayout>