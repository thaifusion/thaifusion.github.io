---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout>

  {/* Header */}
<div class="mt-6 space-y-6 md:mt-5 md:space-y-10">
    <h1 class="text-center text-2xl md:text-4xl">
      <span data-lang="en">Hi there!</span>
      <span data-lang="no">Hei!</span>
    </h1>

    <section class="mt-2 px-6">
  <div class="mx-auto w-full max-w-6xl">

    <!-- MOBIL layout -->
    <div class="flex flex-col items-center gap-4 md:hidden">
      <img
        src="/images/516853435_10239718544880431_3457688934739796084_n.jpg"
        class="mt-3 w-70 h-70 rounded-full object-cover shadow-xl"
      />

      <div class="text-center max-w-xl space-y-4">

         <h1 class="text-2xl mt-5">
            <span data-lang="en">My name is Sara 🌸</span>
          <span data-lang="no">Mitt navn er Sara 🌸</span>
        </h1>

        <p class="uppercase tracking-widest text-sm font-semibold">
          <span data-lang="en">Recently graduated IT student based in Norway</span>
          <span data-lang="no">Nyutdannet IT-student bosatt i Norge</span>
        </p>

        
        <p class="mt-6 mb-10 text-xl">
            <span data-lang="en">I combine technical skills with a creative mindset shaped by my background in art.</span>
            <span data-lang="no">Jeg kombinerer tekniske ferdigheter med et kreativt tankesett formet av min bakgrunn fra kunst.</span>
        </p>
        
        </div>
        
        <img src="/images/maleri.png" class="w-65 h-65 rounded-2xl object-cover shadow-xl" />
        <img src="/images/tegning2.png" class="w-60 h-80 rounded-4xl object-cover shadow-xl" />

    </div>

    <!-- DESKTOP collage -->
    <div class="relative hidden md:block h-120 mb-2">

      <!-- Midtbilde -->
      <img
        src="/images/516853435_10239718544880431_3457688934739796084_n.jpg"
        class="absolute left-1/2 top-1/2 w-90
        -translate-x-1/2 -translate-y-1/2 rounded-full object-cover shadow-2xl z-10
        transition-all duration-900 ease-out hover:scale-105 hover:z-20"
      />

      <!-- Venstre -->
      <img
        src="/images/maleri.png"
        class="absolute left-0 top-[60%] w-80
        -translate-y-1/2 -rotate-6 rounded-2xl object-cover shadow-xl
        transition-all duration-900 ease-out hover:scale-105 hover:z-20"
      />

      <!-- Høyre -->
      <img
        src="/images/tegning2.png"
        class="absolute right-0 top-[60%] w-65
        -translate-y-1/2 rotate-6 rounded-2xl object-cover shadow-xl
        transition-all duration-900 ease-out hover:scale-105 hover:z-20 "
      />

    </div>

    <!-- Desktop text -->
    <div class="hidden md:block text-center max-w-xl mx-auto mt-20 space-y-4">
        
        <h1 class="text-2xl mt-15">
          <span data-lang="en">My name is Sara 🌸</span>
          <span data-lang="no">Mitt navn er Sara 🌸</span>
        </h1>

        <p class="uppercase tracking-widest text-sm font-semibold">
           <span data-lang="en">Recently graduated IT student based in Norway</span>
            <span data-lang="no">Nyutdannet IT-student bosatt i Norge</span>
        </p>

        <p class="mt-10 text-xl">
          <span data-lang="en">I combine technical skills with a creative mindset shaped by my background in art.</span>
          <span data-lang="no">Jeg kombinerer tekniske ferdigheter med et kreativt tankesett formet av min bakgrunn fra kunst.</span>
        </p>
    </div>

  </div>
</section>
 </div>

</BaseLayout>