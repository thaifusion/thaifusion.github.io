---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout>
    
<div class="mt-6 space-y-6 md:mt-8 md:space-y-10">
    <h1 class="text-center text-2xl md:text-4xl">Hi there!</h1>

  <section class="mt-2 px-6">
  <div class="mx-auto w-full max-w-6xl">

    <!-- DESKTOP collage -->
    <div class="relative h-100 mb-5">

      <!-- Midtbilde -->
      <img
        src="/images/516853435_10239718544880431_3457688934739796084_n.jpg"
        class="absolute left-1/2 top-1/2 w-85 mb:w-90
        -translate-x-1/2 -translate-y-1/2 rounded-full object-cover shadow-2xl z-10
        transition-all duration-900 ease-out hover:scale-105 hover:z-20"
      />

      <!-- Venstre -->
      <img
        src="/images/maleri.png"
        class="absolute left-0 top-[60%] w-85 mb:w-90
        -translate-y-1/2 -rotate-6 rounded-2xl object-cover shadow-xl
        transition-all duration-900 ease-out hover:scale-105 hover:z-20"
      />

      <!-- Høyre -->
      <img
        src="/images/tegning2.png"
        class="absolute right-0 top-[60%] w-60 mb:w-70
        -translate-y-1/2 rotate-6 rounded-2xl object-cover shadow-xl
        transition-all duration-900 ease-out hover:scale-105 hover:z-20 "
      />

    </div>

    <!-- Desktop text -->
    <div class=" text-center max-w-xl mx-auto mt-30 space-y-4">
        
        <h1 class="text-2xl mt-15">
            My name is Sara 🌸
        </h1>

        <p class="uppercase tracking-widest text-sm font-semibold">
           IT student based in Norway
        </p>

        <p class="mt-10 text-xl">
            I combine technical skills with a creative mindset shaped by my background in art.
        </p>
    </div>

  </div>
</section>
 </div>

</BaseLayout>