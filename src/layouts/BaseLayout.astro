---
import "../styles/global.css";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import ClickSound from "../components/clickSound.astro";
import { ClientRouter } from "astro:transitions";
---

<html lang="en" data-language="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      const storedLanguage = window.localStorage.getItem("site-language");
      const initialLanguage = storedLanguage === "no" || storedLanguage === "nb" ? "no" : "en";

      document.documentElement.dataset.language = initialLanguage;
      document.documentElement.lang = initialLanguage;
    </script>
    <ClientRouter />
  </head>

  <body>
      <Header />

    <main class="max-w-4xl mx-auto mt-10">
      <slot />
    </main>

    <button
      class="back-to-top"
      type="button"
      data-back-to-top
      aria-label="Back to top"
      title="Back to top"
    >
      ↑
    </button>


    <!-- Persist musikk (så den fortsetter) -->
    <audio id="site-bgm" loop preload="none" data-astro-transition-persist>
      <source
        src="/sounds/792178__bellcoda__offroad-avenue.ogg"
        type="audio/ogg"
      />
    </audio>

    <script>
  const el = document.getElementById("site-bgm");
  const audio = el instanceof HTMLAudioElement ? el : null;

  if (audio) {
    window.__bgm = {
      audio,
      play: async () => audio.play(),
      pause: () => audio.pause(),
      isPlaying: () => !audio.paused,
    };
  }
</script>

    <ClickSound />

  <script type="module">
  import "../scripts/menu.js";
  import "../scripts/language.js";
  import "../scripts/backToTop.js";
  </script>

  <Footer />

  </body>
</html>